# Local development uses Vite's /api proxy by default. Override this value to
# call a different Laravel API directly. Include the /api prefix exactly once;
# API client endpoint paths already begin with /v1.
# Production builds load their API base URL from .env.production.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_EVENT_SLUG=probuild-intim-2026

# Production build is configured in .env.production to use:
# VITE_API_URL=https://backend.probuildintim.com/api

# Optional. Client-side error reports intentionally exclude default PII.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
